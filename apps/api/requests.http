@baseUrl = http://localhost:4000

### Sign up
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "ameksa@example.com",
  "password": "ravici123",
  "displayName": "Ameksa",
  "locale": "ka"
}

### Log in
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ameksa@example.com",
  "password": "ravici123"
}

### who am I? 
GET {{baseUrl}}/api/me
Authorization: Bearer {{login.response.body.accessToken}}

### Refresh 
POST {{baseUrl}}/api/auth/refresh

### Log out
POST {{baseUrl}}/api/auth/logout

### Buy 500 GEL of Lion Finance 
POST {{baseUrl}}/api/orders
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "symbol": "BGEO", "side": "BUY", "amountTetri": "50000" }

### Buy 1,000 GEL of the money market fund 
POST {{baseUrl}}/api/orders
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "symbol": "TMMF", "side": "BUY", "amountTetri": "100000" }

### My orders
GET {{baseUrl}}/api/orders
Authorization: Bearer {{login.response.body.accessToken}}

### My portfolio
GET {{baseUrl}}/api/portfolio
Authorization: Bearer {{login.response.body.accessToken}}