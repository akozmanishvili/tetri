generator client {
  provider           = "prisma-client"
  output             = "../src/generated/prisma"
  moduleFormat       = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}


enum Locale {
  ka
  en
}

enum Currency {
  GEL
  USD
  GBP
  EUR
}

enum InstrumentType {
  MONEY_MARKET_FUND
  BOND_FUND
  EQUITY_FUND
  STOCK
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  EXECUTED
  REJECTED
  CANCELLED
}

enum LedgerEntryType {
  INITIAL_GRANT
  BUY
  SELL
  FEE
}


model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  locale       Locale   @default(ka)
  humorEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet        Wallet?
  holdings      Holding[]
  orders        Order[]
  ledgerEntries LedgerEntry[]
  refreshTokens RefreshToken[]
}


model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceTetri BigInt   @default(0)
  updatedAt    DateTime @updatedAt
}



model Instrument {
  id              String         @id @default(uuid())
  symbol          String         @unique
  nameEn          String
  nameKa          String
  type            InstrumentType
  currency        Currency
  expenseRatioBps Int? 
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  prices   Price[]
  holdings Holding[]
  orders   Order[]
}

// Daily closing price (stocks) or NAV (funds)
model Price {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  date         DateTime   @db.Date
  value        Decimal    @db.Decimal(18, 6)

  @@unique([instrumentId, date])
}


model FxRate {
  id         String   @id @default(uuid())
  currency   Currency
  date       DateTime @db.Date
  gelPerUnit Decimal  @db.Decimal(12, 6)

  @@unique([currency, date])
}



model Order {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId   String
  instrument     Instrument  @relation(fields: [instrumentId], references: [id])
  side           OrderSide
  status         OrderStatus @default(PENDING)
  amountTetri    BigInt? 
  units          Decimal?    @db.Decimal(24, 8) 
  executionPrice Decimal?    @db.Decimal(18, 6)
  fxRate         Decimal?    @db.Decimal(12, 6)
  rejectReason   String?
  createdAt      DateTime    @default(now())
  executedAt     DateTime?

  ledgerEntries LedgerEntry[]

  @@index([status, createdAt]) 
  @@index([userId])
}

model Holding {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId   String
  instrument     Instrument @relation(fields: [instrumentId], references: [id])
  units          Decimal    @db.Decimal(24, 8)
  costBasisTetri BigInt // total GEL paid
  updatedAt      DateTime   @updatedAt

  @@unique([userId, instrumentId])
}


model LedgerEntry {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amountTetri BigInt // signed: +money in, -money out
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}