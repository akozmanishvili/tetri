{
  "name": "tetri",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "test": "npm test --workspace=api",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\""
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
